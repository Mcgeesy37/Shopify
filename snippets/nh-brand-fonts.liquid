{%- comment -%}
  Nordic House: Markenschrift aus dem Logo (DejaVu Serif, freie Lizenz)
  fuer Ueberschriften. Fliesstext bleibt in der Theme-Schrift.
{%- endcomment -%}
{{ 'nordic-serif.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  @font-face {
    font-family: 'Nordic Serif';
    src: url('{{ 'nordic-serif.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Nordic Serif';
    src: url('{{ 'nordic-serif-bold.woff2' | asset_url }}') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  :root {
    --font-heading--family: 'Nordic Serif', Georgia, 'Times New Roman', serif;
    --font-heading--weight: 400;
  }
</style>
